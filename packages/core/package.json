{
  "name": "dsh-remedy-core",
  "version": "0.4.5",
  "description": "Pure repair and redaction engine for the dsh-remedy patch set. Nothing unproven is ever emitted; a failure it cannot split is re-thrown unchanged.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/dsh-remedy.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {},
  "scripts": {
    "build": "tsc -b"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/dsh-remedy#readme",
  "bugs": {
    "url": "https://github.com/jjjjjjjjnnjnn/dsh-remedy/issues"
  }
}
