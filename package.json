{
  "name": "dsh-remedy-workspace",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --fast",
    "record:registry": "node scripts/record_patch_registry.mjs",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run gate",
    "cli": "node packages/plugin/dist/cli.js"
  },
  "devDependencies": {
    "dsh-remedy-core": "workspace:*",
    "dsh-remedy": "workspace:*",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
