{
  "name": "dsh-remedy",
  "version": "0.4.4",
  "description": "DeepSeek Harness patch set that intercepts MALFORMED_RESPONSE streams, splits fused tool-call arguments, re-throws unprovable buffers, and names the deterministic refusals it does not retry.",
  "type": "module",
  "bin": {
    "dsh-remedy": "./dist/cli.js",
    "dsr": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./repair-stream": {
      "types": "./dist/repair-stream.d.ts",
      "default": "./dist/repair-stream.js"
    },
    "./session-scan": {
      "types": "./dist/session-scan.d.ts",
      "default": "./dist/session-scan.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "fixtures",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remedy",
    "repair",
    "tool-call",
    "malformed-response"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjjjjjjjnnjnn/dsh-remedy.git",
    "directory": "packages/plugin"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "dev",
      "summary": {
        "en": "Repairs fused tool-call arguments at the llm/stream seam and re-throws whatever it cannot prove; names the deterministic refusals it will not retry at agent/request-error; answers per failure class which patch covers it here.",
        "zh": "在 llm/stream 接缝上修复粘连的工具调用参数，证不出来的原样抛回；在 agent/request-error 上命名它不重试的确定性拒绝；并按失败类回答哪个补丁在本机覆盖它。"
      },
      "capabilities": [
        "stream-repair",
        "request-error-diagnostics",
        "registry-introspection",
        "offline-scan"
      ]
    },
    "marketplace": {
      "profiles": [
        "desktop",
        "headless",
        "web"
      ],
      "requiresBuildApproval": false,
      "manualSteps": false
    }
  },
  "dependencies": {
    "dsh-remedy-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/sync_fixtures.mjs"
  },
  "homepage": "https://github.com/jjjjjjjjnnjnn/dsh-remedy#readme",
  "bugs": {
    "url": "https://github.com/jjjjjjjjnnjnn/dsh-remedy/issues"
  }
}
